    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    // show target
    document.getElementById(id).classList.add('active');
    btn.classList.add('active');
    // set CSS var for active underline color
    btn.style.setProperty('--uc', btn.style.getPropertyValue('--uc') || 'var(--u1)');
  }

  // Animate probability bars on tab switch
  function animateBars(panel) {
    panel.querySelectorAll('.prob-bar-fill').forEach(bar => {
      const w = bar.style.width;
      bar.style.width = '0%';
      setTimeout(() => { bar.style.width = w; }, 50);
    });
  }

  // Initial animation
  window.addEventListener('load', () => {
    animateBars(document.querySelector('.tab-panel.active'));
  });

  // Animate on tab switch
  const origShowTab = showTab;
  window.showTab = function(id, btn) {
    origShowTab(id, btn);
    setTimeout(() => animateBars(document.getElementById(id)), 30);
  };
</script>
</body>
</html>
